{
  "name": "game-2d-aruan",
  "version": "1.0.0",
  "private": true,
  "description": "Game 2D - Aruan: piloto de RPG de ação 2.5D em Canvas 2D procedural",
  "repository": {
    "type": "git",
    "url": "https://github.com/victorwilliames/game-2d-aruan.git"
  },
  "scripts": {
    "start": "node server.cjs",
    "test": "npm run test:preservation && npm run test:rig && npm run test:game && npm run test:appearance && npm run test:continuity && npm run test:captures",
    "test:rig": "node tests/rig.cjs",
    "test:game": "node tests/game.cjs",
    "test:preservation": "node tests/preservation.cjs",
    "test:captures": "node tests/captures.cjs",
    "test:browser": "node tests/headless.cjs --smoke",
    "test:appearance": "node tests/appearance.cjs",
    "test:continuity": "node tests/continuity.cjs",
    "movalab": "node tools/movalab/scripts/start.cjs",
    "test:movalab": "node tools/movalab/tests/app.cjs",
    "test:mixamo": "node tools/mixamo/tests/acquire.cjs && node tools/movalab/tests/mixamorig-contract.cjs"
  }
}
